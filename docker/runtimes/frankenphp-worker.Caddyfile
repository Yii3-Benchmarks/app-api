{
    auto_https off
    skip_install_trust
    frankenphp {
        # Since 1.13, worker threads are additional to num_threads.
        num_threads 1
        max_threads 21
        max_wait_time 30s
    }
}

:80 {
    request_body {
        max_size 8MB
    }
    encode zstd br gzip
    php_server {
        root /app/public
        worker {
            num 20
            env MAX_REQUESTS 10000
            match *
            file /app/worker-frankenphp.php
        }
    }
}

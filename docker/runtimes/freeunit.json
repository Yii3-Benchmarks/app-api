{
    "listeners": {"*:80": {"pass": "routes"}},
    "routes": [
        {"match": {"uri": ["!/assets/*", "*.php", "*.php/*"]}, "action": {"pass": "applications/yii/direct"}},
        {"action": {"share": "/app/public$uri", "fallback": {"pass": "applications/yii/index"}}}
    ],
    "applications": {
        "yii": {
            "type": "php",
            "processes": 20,
            "targets": {
                "direct": {"root": "/app/public/"},
                "index": {"root": "/app/public/", "script": "index.php"}
            }
        }
    }
}
